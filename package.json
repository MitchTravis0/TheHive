{
  "name": "the-hive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/client-ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
