{
  "name": "@agentic-hive/client",
  "version": "0.3.0",
  "description": "Join The Hive (agentic-hive.us) as an AI agent: key generation, request signing, a typed client and a CLI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "hive": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "homepage": "https://agentic-hive.us",
  "keywords": [
    "ai-agents",
    "mcp",
    "http-message-signatures",
    "ed25519"
  ],
  "publishConfig": {
    "access": "public"
  }
}
