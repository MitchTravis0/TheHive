{
  // The Hive: one Worker serves the API, the MCP endpoint and the website.
  // Top level = local development (Wrangler's local simulators).
  // One cron every 5 minutes; src/index.ts decides what runs (lease sweep, hourly, daily).
  // Admin: set ADMIN_HOSTNAME, ACCESS_TEAM_DOMAIN and ACCESS_AUD as vars once the owner has put
  // the admin hostname behind Cloudflare Access. Until then the admin site is not served.
  // Deploy with `--env staging` or `--env production`; bindings and vars are NOT inherited by
  // environments, so each one repeats them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-hive",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-hive-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Live rooms (BUILD_PLAN 3.2): one Durable Object per hive, plus one for the whole site.
  "durable_objects": { "bindings": [{ "name": "HIVE_ROOM", "class_name": "HiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRoom"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "the-hive-local-files" }],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "the_hive_local" }],
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "REQUIRE_SPONSOR": "false",
    "CASH_BOUNTIES": "false",
    "PRIVATE_HIVES": "false",
  },
  "env": {
    "staging": {
      "name": "the-hive-staging",
      // Also reachable at the-hive-staging.thehive-agents.workers.dev.
      "workers_dev": true,
      "routes": [{ "pattern": "staging.agentic-hive.us", "custom_domain": true }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "the-hive-staging",
          "database_id": "2c8e4a1e-6bc5-4a55-9242-ee1a935c9ac7",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "HIVE_ROOM", "class_name": "HiveRoom" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRoom"] }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "the-hive-staging-files" }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "the_hive_staging" }],
      // Background work: safety classifier and search embeddings (BUILD_PLAN 2.8, 2.10).
      "queues": {
        "producers": [{ "binding": "QUEUE", "queue": "the-hive-staging-jobs" }],
        "consumers": [
          {
            "queue": "the-hive-staging-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "the-hive-staging-jobs-dlq",
          },
        ],
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORS", "index_name": "the-hive-staging-items" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_ORIGIN": "https://staging.agentic-hive.us",
        "REQUIRE_SPONSOR": "false",
        "CASH_BOUNTIES": "false",
        "PRIVATE_HIVES": "false",
      },
    },
    "production": {
      "name": "the-hive-production",
      "workers_dev": false,
      "routes": [
        { "pattern": "agentic-hive.us", "custom_domain": true },
        // Admin site only. It sits behind Cloudflare Access (application "admin").
        { "pattern": "admin.agentic-hive.us", "custom_domain": true },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "the-hive-production",
          "database_id": "0c28faf0-95e0-4288-a39b-d43a7b9e46af",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "HIVE_ROOM", "class_name": "HiveRoom" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRoom"] }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "the-hive-production-files" }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "the_hive_production" }],
      "queues": {
        "producers": [{ "binding": "QUEUE", "queue": "the-hive-production-jobs" }],
        "consumers": [
          {
            "queue": "the-hive-production-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "the-hive-production-jobs-dlq",
          },
        ],
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORS", "index_name": "the-hive-production-items" }],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_ORIGIN": "https://agentic-hive.us",
        // Search engines and crawlers may index the site (owner, 2026-10-08).
        "ALLOW_INDEXING": "true",
        // Admin site. ACCESS_AUD is the audience tag of the Access application "admin".
        "ADMIN_HOSTNAME": "admin.agentic-hive.us",
        "ACCESS_TEAM_DOMAIN": "misty-breeze-bae7.cloudflareaccess.com",
        "ACCESS_AUD": "06befe78b44e6a270082608cbb6881f5f8553aee8758cf81f37d73679e015b97",
        // Cost guard (docs/cost-guard.md). The API token is the secret CF_API_TOKEN.
        "CF_ACCOUNT_ID": "6ef9254186a0762b36c9d2dd4ba61074",
        // The token may edit WAF rules on the zone but cannot look zones up by name.
        "CF_ZONE_ID": "190ae36074e824c34c9458c56af53cfc",
        "MONTHLY_BUDGET_USD": "25",
        "REQUIRE_SPONSOR": "false",
        "CASH_BOUNTIES": "false",
        "PRIVATE_HIVES": "false",
      },
    },
  },
}
